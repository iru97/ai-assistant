# Supabase Configuration
# Get these values from https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI Configuration
# NOTE: This should NOT be set in your local .env file
# The OpenAI API key should only be set as a Supabase secret:
# supabase secrets set OPENAI_API_KEY=your-openai-api-key
#
# This prevents exposing your API key in the client application
# EXPO_PUBLIC_OPENAI_API_KEY=DO_NOT_SET_THIS_HERE
